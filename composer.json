{
    "name": "esaalat/esaalat-php",
    "description": "Server-side Esaalat client for PHP: locked checkout sessions, payment intents and signed webhook verification.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://esaalat.com/en/sdk",
    "keywords": ["esaalat", "payments", "checkout", "webhook", "yemen"],
    "authors": [
        {
            "name": "Esaalat",
            "email": "support@esaalat.com",
            "homepage": "https://esaalat.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Esaalat/esaalat-php/issues",
        "source": "https://github.com/Esaalat/esaalat-php",
        "docs": "https://esaalat.com/en/sdk"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "Faster transport. Without it the client falls back to PHP streams."
    },
    "autoload": {
        "psr-4": {
            "Esaalat\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/smoke.php"
    },
    "config": {
        "sort-packages": true
    }
}
